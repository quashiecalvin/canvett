# Backend environment variables for local development. Copy to "backend/.env".
# In production (Render) set these on the dashboard instead.

# Google OAuth Web client ID - must match VITE_GOOGLE_CLIENT_ID in the frontend.
GOOGLE_CLIENT_ID=

# Optional overrides (sensible defaults exist for local development):
# DATABASE_URL=postgresql://user@localhost:5432/canvett
# SECRET_KEY=change-me-in-production
# APP_ENV=development
# ALLOWED_ORIGINS=http://localhost:5173
